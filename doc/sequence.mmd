sequenceDiagram
    title Scénario : montant d'un vendeur
    actor Directeur
    participant Enseigne
    participant Vendeur

    Directeur->>Enseigne: authentifier(identifiant, motDePasse)
    alt authentification échouée
        Enseigne-->>Directeur: erreurAuthentification
    else authentification réussie
        Enseigne-->>Directeur: menu
        Directeur->>Enseigne: montantVendeur()
        Enseigne-->>Directeur: listeVendeurs
        Directeur->>Enseigne: choisirVendeur(vendeur)
        Enseigne->>Vendeur: montantTotalVendeur()
        Vendeur-->>Enseigne: montant
        Enseigne-->>Directeur: montantDuVendeur
    end
