classDiagram
  direction LR

  class Enseigne {
    +str nom
    +liste_vendeurs() list~Vendeur~
    +montant_moyen_par_client() float
  }
  class Magasin {
    +str nom
    +str ville
  }
  class SiteInternet {
    +str url
  }
  class SecteurActivite {
    +str nom
    +montant_total() float
  }
  class Rayon {
    +int compteur$
    +str code_rayon
    +str nom
    +montant_total() float
    +__del__()
  }
  class Produit {
    +str code
    +str libelle
    +float prix
  }
  class Personne {
    <<abstract>>
    +str nom
    +str prenom
    +str tel
    +str mail
    +afficher()
  }
  class Vendeur {
    +date date_prise_fonction
    +int indice_salaire
    +float montant_ventes
    +ajouter_vente(montant float)
    +montant_total() float
    +fiche_signaletique() str
    +imprimer_fiche()
  }
  class Client {
    +acheter(produit Produit, quantite int) Achat
    +montant_moyen_achat() float
  }
  class Achat {
    +int quantite
    +datetime date
    +montant() float
  }

  Personne <|-- Vendeur
  Personne <|-- Client
  Enseigne --> "1..*" Magasin : magasins
  Enseigne --> "*" Client : clients
  Magasin --> "1" SiteInternet : site_internet
  Magasin --> "1..*" SecteurActivite : secteurs
  SecteurActivite --> "1..*" Rayon : rayons
  SecteurActivite --> "1..*" Vendeur : vendeurs
  SecteurActivite --> "1" Vendeur : responsable
  Rayon --> "*" Produit : produits
  Rayon --> "1" Vendeur : vendeur
  Vendeur --> "1" Rayon : rayon
  Produit --> "1" Rayon : rayon
  Client --> "*" Achat : achats
  Achat --> "1" Produit : produit
